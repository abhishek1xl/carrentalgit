# Environment Configuration
# Copy this file to .env and update with your values

# GitHub Pages deployment URL (no trailing slash)
REACT_APP_GITHUB_PAGES_URL=https://YOUR_USERNAME.github.io/car-rental-system

# API endpoints (if using external API)
REACT_APP_API_URL=http://localhost:5000

# Company configuration
REACT_APP_COMPANY_NAME=1XL Car Rentals
REACT_APP_CURRENCY=AED
